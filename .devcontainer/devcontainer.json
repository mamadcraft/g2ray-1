{
  "name": "g2ray",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    },        
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "postAttachCommand": {
    // استفاده از & در انتهای دستور باعث می‌شود پروسه در پس‌زمینه بماند و ستاپ متوقف نشود
    "start": "nohup sudo /usr/local/bin/xray run -c /etc/xray/g2ray.json > /tmp/xray.log 2>&1 &"
  },
  "portsAttributes": {
    "443": {
      "label": "g2ray",
      "protocol": "https", // چون TLS استفاده می‌کنید https بهتر است
      "visibility": "public", // مهم‌ترین بخش برای حل ارور 401
      "onAutoForward": "openPreview" 
    }
  },
  "forwardPorts": [443],
  "hostRequirements": {
    "cpus": 2
  }
}
